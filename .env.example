# Database connection
# Default: Local SQLite (Zero-dependency, immediate run)
DATABASE_URL="file:./dev.db"
# For Docker PostgreSQL, uncomment:
# DATABASE_URL="postgresql://medibook:medibook_password_secure@localhost:5432/medibook_ai?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="medibook-super-secret-production-key-32-chars-at-least"
NEXTAUTH_URL="http://localhost:3000"

# Slot Locking - Redis (falls back automatically to in-memory mutex if Redis is not running)
REDIS_URL="redis://localhost:6379"

# AI Triage - Anthropic Claude API
# If left empty, MediBook AI runs seamlessly in Deterministic Mock-AI mode
ANTHROPIC_API_KEY=""
MOCK_AI_MODE="true"

# Data Security & DPDP Compliance
# 32-character AES-256 secret key for encrypting patient clinical notes
DATA_ENCRYPTION_KEY="medibook_aes_encryption_key_32c"
