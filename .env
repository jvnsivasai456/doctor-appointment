# Database: Local SQLite (Zero-dependency native run, no Docker needed)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_SECRET="medibook-super-secret-production-key-32-chars-at-least"
NEXTAUTH_URL="http://localhost:3000"

# Redis URL (Falls back automatically to high-performance in-memory mutex when Redis is not running)
REDIS_URL="redis://localhost:6379"

# AI Triage - Anthropic Claude API (Runs in smart clinical mock triage mode if empty)
ANTHROPIC_API_KEY=""
MOCK_AI_MODE="true"

# Data Security & DPDP Compliance (32-character AES-256 key for encrypting patient symptoms)
DATA_ENCRYPTION_KEY="medibook_aes_encryption_key_32c"
